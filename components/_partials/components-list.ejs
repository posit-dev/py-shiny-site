<% for (const item of items) { %>

<% if (item.preview || item.appPreview) { %>
<% const previewBase = item.path.replace(/index\.qmd$/, "").replace(/index\.html$/, ""); %>
<% const thumbnailPath = `${previewBase}thumbnail.png`; %>
<% const animationPath = `${previewBase}preview.gif`; %>
<% const thumbnailVersion = Deno.statSync(thumbnailPath.replace(/^\//, "")).mtime?.getTime() ?? 0; %>
<% const animationVersion = Deno.statSync(animationPath.replace(/^\//, "")).mtime?.getTime() ?? 0; %>
<% const thumbnailSrc = `${thumbnailPath}?v=${thumbnailVersion}`; %>
<% const animationSrc = `${animationPath}?v=${animationVersion}`; %>
<div class="g-col-lg-4 g-col-12 component-list-column">
<div class="component-list-header">
<a class="component-list-header-text" href="<%= item.path %>">
<div class="h5"><%= item.title %></div>
</a>
<div class="component-list-icon">
<p class="my-0"><a class="text-decoration-none dark" href="<%= item.path %>" aria-label="View <%= item.title %> component">
<i class="component-link-icon dark bi fst-normal"></i>
</a></p>
</div>
</div>
<a class="component-list-card" href="<%= item.path %>" aria-label="View <%= item.title %> component">
<img
  class="component-list-preview"
  src="<%= thumbnailSrc %>"
  data-static-src="<%= thumbnailSrc %>"
  data-animated-src="<%= animationSrc %>"
  alt="<%= item.title %> component preview"
  loading="lazy"
  decoding="async"
  width="450"
  height="253"
>
<span class="component-list-preview-hint" aria-hidden="true">
<i class="bi bi-play-fill"></i> Preview
</span>
</a>
</div>
<% } %>

<% } %>
